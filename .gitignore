# -----------------------------------------------------------------------------
# Enterprise baseline: keep secrets, local state, and generated artifacts out
# of version control while preserving source, configs, and lockfiles.
# -----------------------------------------------------------------------------

# Secrets and environment-local configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.test.example
*.local
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Logs and runtime artifacts
*.log
logs/
log/
*.pid
*.pid.lock
*.seed
*.stackdump
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride

# Editor and IDE metadata
.idea/
.vscode/
*.iml
*.suo
*.user
*.userossc
*.rsuser
*.swp
*.swo
*~

# Backend: Java / Maven / Spring Boot
backend/target/
backend/out/
.mvn/timing.properties
hs_err_pid*
replay_pid*
*.class
*.jar
*.war
*.ear

# Frontend: Bun / Node / Vite / TanStack Start
frontend/node_modules/
frontend/.bun/
frontend/.cache/
frontend/.eslintcache
frontend/.vite/
frontend/dist/
frontend/build/
frontend/coverage/
frontend/.wrangler/
frontend/.turbo/
frontend/.output/

# Test, coverage, and caches
.cache/
.temp/
.tmp/
tmp/
temp/
coverage/
.nyc_output/
.parcel-cache/

# Local databases and binary dumps
*.db
*.sqlite
*.sqlite3

# Generated route manifests (commit only if your workflow requires deterministic routing output)
# frontend/src/routeTree.gen.ts
